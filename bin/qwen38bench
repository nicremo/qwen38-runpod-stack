#!/usr/bin/env python3
"""qwen38bench - measure what the running pod actually decodes at.

    qwen38bench                 # picks the only running pod
    qwen38bench <POD_ID>
    qwen38bench --isl 8192      # match the cookbook's ISL 8192 / OSL 1024 point

Reports TTFT and decode tok/s using server-reported completion_tokens, NOT the
number of SSE chunks. Missing usage produces n/a instead of fabricated tok/s.
The output is measured over the RunPod proxy, not inside the GPU server. A number without warmup is 2 to 10 times too low,
so the first run is always discarded.

Every figure printed here is single-stream (concurrency 1). That is the number
that matters for a chat session; it is NOT the same as aggregate throughput.
"""
import argparse
import json
import subprocess
import sys
import time
import urllib.error
import urllib.request

PROMPT = (
    "Write a detailed technical explanation of how speculative decoding works "
    "in a transformer inference server, covering draft models, verification, "
    "and acceptance rates."
)


def running_pod() -> str:
    out = subprocess.run(
        ["runpodctl", "pod", "list", "-o", "json"],
        capture_output=True, text=True, check=False,
    )
    pods = json.loads(out.stdout or "[]")
    if len(pods) != 1:
        sys.exit(f"{len(pods)} Pods am Laufen, Pod-ID bitte angeben")
    return pods[0]["id"]


# RunPod's proxy answers 403 to the default Python-urllib user agent.
HEADERS = {
    "Content-Type": "application/json",
    "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) qwen38bench",
}


def get(url: str, timeout: int = 30):
    req = urllib.request.Request(url, headers=HEADERS)
    return urllib.request.urlopen(req, timeout=timeout)


def post(url: str, payload: dict, timeout: int = 600):
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers=HEADERS,
    )
    return urllib.request.urlopen(req, timeout=timeout)


def sse_events(response):
    """Yield complete SSE data payloads (not chunks/tokens).

    SSE fields can span multiple lines; event boundaries are blank lines.
    Comments and keepalives are ignored.
    """
    data = []
    for raw in response:
        line = raw.decode("utf-8").rstrip("\r\n")
        if line.startswith("data:"):
            data.append(line[5:].lstrip(" "))
        elif not line:
            if data:
                yield "\n".join(data)
                data = []
    if data:
        yield "\n".join(data)


def one_run(api: str, model: str, isl: int, osl: int, stream: bool = True) -> dict:
    prompt = PROMPT
    if isl > 0:
        # Approximate padding, NOT measured input tokens.
        prompt = (PROMPT + " ") * max(1, isl // 25)
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": osl,
        "temperature": 0.6,
        "top_p": 0.95,
        "stream": stream,
        "stream_options": {"include_usage": True} if stream else None,
        "chat_template_kwargs": {"enable_thinking": False},
    }
    payload = {k: v for k, v in payload.items() if v is not None}

    start = time.perf_counter()
    ttft = None
    usage = None
    if stream:
        done = False
        with post(f"{api}/chat/completions", payload) as resp:
            for body in sse_events(resp):
                if body == "[DONE]":
                    done = True
                    break
                chunk = json.loads(body)
                if isinstance(chunk.get("usage"), dict):
                    usage = chunk["usage"]
                for choice in chunk.get("choices") or []:
                    delta = choice.get("delta") or {}
                    # TTFT is the first output, not a role-only SSE event.
                    tool_output = any(
                        (call.get("function") or {}).get("arguments")
                        for call in delta.get("tool_calls") or []
                        if isinstance(call, dict)
                    )
                    if ttft is None and (
                        delta.get("content") or delta.get("reasoning_content")
                        or tool_output
                    ):
                        ttft = time.perf_counter() - start
        if not done:
            raise ValueError("incomplete SSE response (missing [DONE])")
    else:
        # Non-streaming responses cannot provide a meaningful TTFT/decode rate.
        with post(f"{api}/chat/completions", payload) as resp:
            result = json.load(resp)
        if isinstance(result.get("usage"), dict):
            usage = result["usage"]

    total = time.perf_counter() - start
    out_tokens = (usage or {}).get("completion_tokens")
    # An SSE event is NOT a token; never invent a token count from chunk count.
    if type(out_tokens) is not int or out_tokens < 0:
        out_tokens = None
    decode_time = total - ttft if ttft is not None else None
    # The first generated token arrived at TTFT, before the decode interval.
    tps = ((out_tokens - 1) / decode_time
           if out_tokens is not None and out_tokens > 1
           and decode_time is not None and decode_time > 0 else None)
    return {
        "ttft": ttft,
        "total": total,
        "out_tokens": out_tokens,
        "prompt_tokens": (usage or {}).get("prompt_tokens"),
        "tps": tps,
        "token_count_source": "server_usage" if out_tokens is not None
                              else "unavailable",
    }


def server_info(api: str) -> dict:
    try:
        base = api.rsplit("/v1", 1)[0]
        with get(f"{base}/get_server_info", timeout=15) as r:
            return json.loads(r.read())
    except Exception:
        return {}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("pod_id", nargs="?")
    ap.add_argument("--isl", type=int, default=8192, help="input length in tokens")
    ap.add_argument("--osl", type=int, default=1024, help="output length in tokens")
    ap.add_argument("--runs", type=int, default=3, help="measured runs after warmup")
    args = ap.parse_args()
    if args.runs < 1 or args.osl < 1 or args.isl < 0:
        ap.error("--runs/--osl must be positive, --isl must be nonnegative")

    pod = args.pod_id or running_pod()
    api = f"https://{pod}-8000.proxy.runpod.net/v1"

    with get(f"{api}/models") as r:
        model = json.loads(r.read())["data"][0]["id"]
    print(f"Pod {pod} | model {model}")
    print(f"ISL {args.isl} / OSL {args.osl}, concurrency 1\n")

    print("Warmup (discarded)...", flush=True)
    one_run(api, model, args.isl, args.osl)

    results = []
    for i in range(args.runs):
        r = one_run(api, model, args.isl, args.osl)
        results.append(r)
        speed = f"{r['tps']:.1f}" if r["tps"] is not None else "n/a"
        latency = f"{r['ttft'] * 1000:.0f}" if r["ttft"] is not None else "n/a"
        out_tokens = (str(r["out_tokens"]) if r["out_tokens"] is not None
                      else "n/a (server usage unavailable)")
        print(f"  run {i + 1}: {speed} tok/s | TTFT {latency} ms "
              f"| {out_tokens} server tokens")

    # Missing server usage must never become a fake decode speed or crash.
    tps = sorted(r["tps"] for r in results if r["tps"] is not None)
    ttft = sorted(r["ttft"] for r in results if r["ttft"] is not None)
    if tps:
        middle = len(tps) // 2
        median_tps = ((tps[middle - 1] + tps[middle]) / 2
                      if len(tps) % 2 == 0 else tps[middle])
        speed_report = (f"{median_tps:.1f} tok/s | "
                        f"TPOT {1000 / median_tps:.2f} ms"
                        if median_tps > 0 else "n/a")
    else:
        speed_report = "n/a (server usage unavailable)"
    if ttft:
        middle = len(ttft) // 2
        median_ttft = ((ttft[middle - 1] + ttft[middle]) / 2
                       if len(ttft) % 2 == 0 else ttft[middle])
        latency_report = f"{median_ttft * 1000:.0f} ms"
    else:
        latency_report = "n/a"
    print(f"\n  Median: {speed_report} | TTFT {latency_report}")
    print("  Token counts are from completion_tokens in server usage; "
          "SSE chunks are never counted as tokens.")

    info = server_info(api)
    for key in ("speculative_algorithm", "avg_spec_accept_length",
                "accept_length", "max_running_requests"):
        if key in info:
            print(f"  {key}: {info[key]}")

    print("\nWithout hardware, engine version, quantization and context length "
          "every one of these numbers is worthless. All four belong in the log.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
