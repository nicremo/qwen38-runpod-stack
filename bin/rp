#!/usr/bin/env bash
# rp - runpodctl wrapper that applies the best available shutdown protection.
#
# Injects --terminate-after when the installed runpodctl supports it. Some
# releases do not expose a server-side timer; in that case the local reaper
# remains active and the wrapper does not pass an unsupported flag.
#
# Usage: exactly like runpodctl, e.g.  rp pod create --name x --gpu-id "..."
#
#   rp pod create --name test ...              1h reaper window
#   rp 6h pod create --name train ...          6h if server timer is supported
#   RUNPOD_MAX_AGE_HOURS=6 rp pod create ...   same request via env
#
# Longer-lived pods get a "keep-" prefix only when a server-side timer protects
# them. Without one, the reaper keeps enforcing its own window instead of
# allowing an unbounded pod.

set -uo pipefail

RUNPODCTL="${RUNPODCTL_BIN:-/opt/homebrew/bin/runpodctl}"
REAPER_WINDOW_HOURS=1   # must match RUNPOD_MAX_AGE in the LaunchAgent

# Leading duration shorthand:  rp 6h pod create ...
if [[ "${1:-}" =~ ^([0-9]+)h$ ]]; then
    MAX_AGE_HOURS="${BASH_REMATCH[1]}"
    shift
else
    MAX_AGE_HOURS="${RUNPOD_MAX_AGE_HOURS:-1}"
fi

if [[ ! -x "$RUNPODCTL" ]]; then
    echo "rp: runpodctl not found at $RUNPODCTL" >&2
    exit 127
fi

if [[ "${1:-}" == "pod" && "${2:-}" == "create" ]]; then
    create_help=$("$RUNPODCTL" pod create --help 2>&1 || true)
    timer_supported=0
    if grep -q -- '--terminate-after' <<<"$create_help"; then
        timer_supported=1
    fi

    has_timer=0
    for arg in "$@"; do
        case "$arg" in
            --terminate-after|--terminate-after=*|--stop-after|--stop-after=*)
                has_timer=1
                ;;
        esac
    done

    server_timer=0
    if [[ $has_timer -eq 1 ]]; then
        server_timer=1
        echo "rp: timer flag already present, leaving it alone" >&2
    elif [[ $timer_supported -eq 1 ]]; then
        deadline=$(date -u -v "+${MAX_AGE_HOURS}H" '+%Y-%m-%dT%H:%M:%SZ')
        echo "rp: auto-terminate set to $deadline (+${MAX_AGE_HOURS}h)" >&2
        set -- "$@" --terminate-after "$deadline"
        server_timer=1
    else
        echo "rp: runpodctl has no --terminate-after support; relying on the local reaper" >&2
    fi

    # Shield longer-lived pods only when RunPod can enforce their deadline.
    if [[ $server_timer -eq 1 && $MAX_AGE_HOURS -gt $REAPER_WINDOW_HOURS ]]; then
        rebuilt=()
        renamed=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --name)
                    if [[ "${2:-}" != keep-* ]]; then
                        rebuilt+=("$1" "keep-${2:-}")
                        renamed=1
                    else
                        rebuilt+=("$1" "${2:-}")
                    fi
                    shift 2
                    ;;
                --name=*)
                    value="${1#--name=}"
                    if [[ "$value" != keep-* ]]; then
                        rebuilt+=("--name=keep-$value")
                        renamed=1
                    else
                        rebuilt+=("$1")
                    fi
                    shift
                    ;;
                *)
                    rebuilt+=("$1")
                    shift
                    ;;
            esac
        done
        set -- "${rebuilt[@]}"
        if [[ $renamed -eq 1 ]]; then
            echo "rp: window is longer than the reaper's ${REAPER_WINDOW_HOURS}h," \
                 "prefixed the name with keep- so it survives" >&2
        fi
    elif [[ $MAX_AGE_HOURS -gt $REAPER_WINDOW_HOURS ]]; then
        echo "rp: requested ${MAX_AGE_HOURS}h cannot be protected server-side;" \
             "the reaper will still enforce its ${REAPER_WINDOW_HOURS}h limit" >&2
    fi
fi

exec "$RUNPODCTL" "$@"
